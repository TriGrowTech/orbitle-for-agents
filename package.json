{
  "name": "orbitle",
  "version": "1.0.0",
  "description": "Orbitle - Unified SaaS Platform for Travel Industry",
  "private": true,
  "workspaces": [
    "server",
    "client/agent-dashboard",
    "client/agent-marketplace",
    "client/superadmin"
  ],
  "scripts": {
    "dev": "concurrently --names \"API,DASH,MARKET,ADMIN\" --prefix-colors \"yellow,green,magenta,cyan\" \"npm run dev:api\" \"npm run dev:dash\" \"npm run dev:market\" \"npm run dev:admin\"",
    "dev:api": "npm run dev --workspace=server",
    "dev:dash": "npm run dev --workspace=@orbitle/agent-dashboard",
    "dev:market": "npm run dev --workspace=@orbitle/agent-marketplace",
    "dev:admin": "npm run dev --workspace=@orbitle/superadmin",
    "build:dash": "npm run build --workspace=@orbitle/agent-dashboard",
    "build:market": "npm run build --workspace=@orbitle/agent-marketplace",
    "build:admin": "npm run build --workspace=@orbitle/superadmin",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TriGrowTech/orbitle-for-agents.git"
  },
  "author": "GopalShukla",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/TriGrowTech/orbitle-for-agents/issues"
  },
  "homepage": "https://github.com/TriGrowTech/orbitle-for-agents#readme",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
